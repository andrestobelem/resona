{
  "name": "@resona/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "resona": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm --filter @resona/engine build && pnpm --filter @resona/renderer build && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resona/engine": "workspace:*",
    "@resona/renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
