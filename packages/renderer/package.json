{
  "name": "@resona/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audio-engine": {
      "types": "./dist/audio-engine.d.ts",
      "default": "./dist/audio-engine.js"
    },
    "./audio-worklet": {
      "types": "./dist/audio-worklet.d.ts",
      "default": "./dist/audio-worklet.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm --filter @resona/engine build && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resona/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
