{
  "name": "@resona/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "docs:clean": "pnpm run build && node dist/cli.js clean",
    "docs:build": "pnpm run build && node dist/cli.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "highlight.js": "11.11.1",
    "marked": "18.0.7",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
